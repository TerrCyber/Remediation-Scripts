<#
.SYNOPSIS
    This PowerShell script turns off Microsoft consumer experiences by configuring
    the DisableWindowsConsumerFeatures registry value.
.NOTES
    Author          : Terrance Fortson
    LinkedIn        : linkedin.com/in/terrancefortson/
    GitHub          : github.com/terrcyber
    Date Created    : 2026-03-12
    Last Modified   : 2026-03-12
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000197
.TESTED ON
    Date(s) Tested  : 
    Tested By       : 
    Systems Tested  : 
    PowerShell Ver. : 
.USAGE
    Run with administrative privileges.
    Example syntax:
    PS C:\> .\WN11-CC-000197_remediation.ps1
#>

$registryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\CloudContent"
$valueName    = "DisableWindowsConsumerFeatures"
$valueData    = 1

New-Item -Path $registryPath -Force | Out-Null
Set-ItemProperty -Path $registryPath -Name $valueName -Value $valueData -Type DWord -Force

Write-Host "STIG WN11-CC-000197 remediation applied successfully." -ForegroundColor Green
